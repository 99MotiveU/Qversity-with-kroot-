# Prod (운영)
# 실행: gradlew bootRun -Pprofile=prod  (또는 배포 환경변수로 주입)

# URLs — 실제 운영 도메인으로 교체
APP_FRONTEND_URL=https://www.example.com
APP_BACKEND_URL=https://api.example.com
SERVER_PORT=18080
DB_URL=jdbc:postgresql://localhost:5432/qversity

# Database
DB_USERNAME=qversity
DB_PASSWORD=qversity

# JWT
JWT_SECRET=prod-jwt-secret-key-minimum-32-characters

# OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
KAKAO_CLIENT_ID=your_kakao_client_id_here
KAKAO_CLIENT_SECRET=your_kakao_client_secret_here
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
