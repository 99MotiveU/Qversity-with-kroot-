# Local (Podman PostgreSQL)
# 실행: gradlew bootRun -Pprofile=local

# URLs
APP_FRONTEND_URL=http://localhost:4000
APP_BACKEND_URL=http://localhost:18080
SERVER_PORT=18080
DB_URL=jdbc:postgresql://localhost:5432/qversity

# Database
DB_USERNAME=qversity
DB_PASSWORD=qversity

# JWT
JWT_SECRET=local-dev-jwt-secret-key-min-32-chars

# OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
KAKAO_CLIENT_ID=your_kakao_client_id_here
KAKAO_CLIENT_SECRET=your_kakao_client_secret_here
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
